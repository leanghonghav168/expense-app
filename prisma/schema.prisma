generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  username  String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  expenses   Expense[]
  categories Category[]
  passkeys   Passkey[]
}

model Passkey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Expense {
  id         String    @id @db.Uuid
  userId     String?   @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  amount     Decimal   @db.Decimal(14, 2)
  currency   String
  type       String
  category   String
  occurredAt DateTime
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([occurredAt])
  @@index([updatedAt])
  @@index([deletedAt])
}

model Category {
  id        String    @id @db.Uuid
  userId    String?   @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  icon      String?
  color     String?
  isDefault Boolean   @default(false)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([updatedAt])
  @@index([deletedAt])
}

model SyncMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
